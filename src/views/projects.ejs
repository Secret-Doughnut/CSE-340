<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Upcoming Service Projects</h2>
        <ul class="project-list">
            <% projects.forEach(project=> {
                const formattedDate = new Date(project.project_date).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
                })%>


                <li class="project-card">
                    <h3 class="project-title">
                        <%= formattedDate %>: <a class="project-link" href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a> <a class="organization-link" href="/organization/<%= project.organization_id %>">
                                <%= project.name %>
                            </a>
                    </h3>
                    <p class="project-description">
                        <%= project.description %>
                    </p>
                    <p class="project-location">
                        <%= project.location %>
                    </p>
                </li>
                <% }); %>
        </ul>
    </main>

        <p><a href="/new-project">Add a new service project</a></p>

    <%- include('partials/footer') %>