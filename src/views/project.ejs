<%- include('partials/header') %>
    <% const formattedDate=new Date(projectDetails.project_date).toLocaleDateString('en-US', { year: 'numeric' ,
        month: 'long' , day: 'numeric' })%>

        <main>
            <h1>
                <%= title %>
            </h1>
            <p>
                <%= projectDetails.description %>
            </p>
            <p>
                <%= formattedDate %>
            </p>
            <p>
                <%= projectDetails.location %>
            </p>
            <a href="/organization/<%= projectDetails.organization_id %>">
                <%= projectDetails.name %>
            </a>
            <ul>
                <% projectCategories.forEach(category=> { %>
                    <li>
                        <a href="/category/<%=category.category_id %>">
                            <%= category.name %>
                        </a>
                    </li>
                    <% }) %>
            </ul>
        </main>

        <a href="/project/<%= projectDetails.project_id %>/assign-categories">
            Edit Categories
        </a>
        <a href="/edit-project/<%= projectDetails.project_id %>">
            Edit project
        </a>

        <%- include('partials/footer') %>